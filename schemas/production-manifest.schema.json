{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meaningframe.com/schemas/production-manifest.schema.json",
  "title": "MEANINGFRAME Production Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "orderReference",
    "edition",
    "frameColour",
    "artwork",
    "curatorNote",
    "customerApproval",
    "preflight",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "orderReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "edition": {
      "type": "string",
      "enum": ["digital", "signature"]
    },
    "frameColour": {
      "type": ["string", "null"],
      "enum": ["black", "natural", null]
    },
    "artwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "fileName", "format", "width", "height", "effectiveDpi", "colourSpace", "sha256"],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "format": {
          "type": "string",
          "enum": ["PNG", "TIFF", "PDF", "SVG"]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "effectiveDpi": {
          "type": ["number", "null"],
          "minimum": 1
        },
        "colourSpace": {
          "type": "string",
          "enum": ["sRGB", "provider_required_profile", "not_applicable_vector"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "curatorNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "fileName", "format", "sha256"],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "format": {
          "type": "string",
          "const": "PDF"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "customerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedAt", "artworkVersionId", "curatorNoteVersionId"],
      "properties": {
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "artworkVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "curatorNoteVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks", "checkedAt"],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "passed", "message"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "passed": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
