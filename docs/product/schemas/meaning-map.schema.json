{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meaningframe.com/schemas/meaning-map.schema.json",
  "title": "MEANINGFRAME Meaning Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "locale",
    "subjectDisplayName",
    "essence",
    "identityTraits",
    "lifeAnchors",
    "visualSymbols",
    "emotionalDirection",
    "colourAtmosphere",
    "mustInclude",
    "mustAvoid",
    "uncertainties",
    "safetyFlags"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "locale": {
      "type": "string",
      "enum": ["de-CH", "en"]
    },
    "subjectDisplayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "essence": {
      "$ref": "#/$defs/evidencedText"
    },
    "identityTraits": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "interpretation", "evidenceIds", "confidence"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "interpretation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "evidenceIds": {
            "$ref": "#/$defs/evidenceIds"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "lifeAnchors": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "kind", "meaning", "evidenceIds", "confidence"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": ["memory", "place", "life_chapter", "relationship", "passion", "object"]
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "evidenceIds": {
            "$ref": "#/$defs/evidenceIds"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "visualSymbols": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "meaning", "origin", "evidenceIds", "confidence"],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "origin": {
            "type": "string",
            "enum": ["co_author_selected", "ai_proposed"]
          },
          "evidenceIds": {
            "$ref": "#/$defs/evidenceIds"
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "emotionalDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "intendedRecipientFeeling", "evidenceIds"],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "secondary": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "intendedRecipientFeeling": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "colourAtmosphere": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paletteWords", "mood", "evidenceIds"],
      "properties": {
        "paletteWords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "mood": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "mustInclude": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/evidencedText"
      }
    },
    "mustAvoid": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/evidencedText"
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "reason", "blocking"],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "safetyFlags": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "customerSafeMessage"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "severity": {
            "type": "string",
            "enum": ["info", "review", "block"]
          },
          "customerSafeMessage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["confirmed", "strong", "tentative"]
    },
    "evidencedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidenceIds", "confidence"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    }
  }
}
