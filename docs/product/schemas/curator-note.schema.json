{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meaningframe.com/schemas/curator-note.schema.json",
  "title": "MEANINGFRAME Curator's Note",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "locale",
    "voice",
    "meaningMapVersionId",
    "artworkVersionId",
    "title",
    "opening",
    "artworkReading",
    "symbolNotes",
    "closing",
    "coCreationDisclosure",
    "evidenceIds"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "locale": {
      "type": "string",
      "enum": ["de-CH", "en"]
    },
    "voice": {
      "type": "string",
      "enum": ["personal_warm", "poetic", "curatorial"]
    },
    "meaningMapVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "artworkVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "opening": {
      "type": "string",
      "minLength": 120,
      "maxLength": 650
    },
    "artworkReading": {
      "type": "string",
      "minLength": 500,
      "maxLength": 2400
    },
    "symbolNotes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "interpretation", "evidenceIds"],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "interpretation": {
            "type": "string",
            "minLength": 60,
            "maxLength": 500
          },
          "evidenceIds": {
            "$ref": "#/$defs/evidenceIds"
          }
        }
      }
    },
    "closing": {
      "type": "string",
      "minLength": 80,
      "maxLength": 700
    },
    "coCreationDisclosure": {
      "type": "string",
      "minLength": 30,
      "maxLength": 400
    },
    "evidenceIds": {
      "$ref": "#/$defs/evidenceIds"
    }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    }
  }
}
